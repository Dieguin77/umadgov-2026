# Supabase Configuration (obrigatório)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_STORAGE_BUCKET=comprovantes

# WhatsApp
VITE_WHATSAPP_NUMBER=5533999186633
VITE_WHATSAPP_NUMBER_2=5533991060488

# Instagram
VITE_INSTAGRAM_USER=umadgov

# Shirt Price
VITE_SHIRT_PRICE=50

# InfinitePay (pagamento por cartão) — usada SOMENTE pelas serverless
# functions em /api (nunca prefixar com VITE_, senão fica exposta no
# bundle do cliente). É a sua InfiniteTag, sem o símbolo $.
# Configure no painel da Vercel (Project Settings > Environment Variables),
# não é necessária para o VITE_SHIRT_PRICE/Supabase acima.
INFINITEPAY_HANDLE=seu-handle-sem-cifrao
